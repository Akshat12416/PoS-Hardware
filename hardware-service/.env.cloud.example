# Cloud API (Render) — copy to the cloud host environment. Never commit real secrets.

NODE_ENV=production
PORT=10000
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

CLOUD_URL=https://pos-7mvx.onrender.com
CORS_ORIGIN=https://YOUR-POS-APP.example

INTEGRATION_SECRET=
CLOUD_API_SECRET=
REQUIRE_PRODUCTION_SECURITY=true
REQUIRE_STORE_AUTH=true

# Optional: extra ngrok/custom tunnel hosts, comma-separated
# HARDWARE_URL_HOST_ALLOWLIST=ngrok-free.dev,ngrok.io,ngrok.app

CONVERGE_ENV=production
CONVERGE_API_BASE_URL=https://api.convergepay.com
CONVERGE_SSL_MERCHANT_ID=
CONVERGE_SSL_USER_ID=
CONVERGE_SSL_PIN=

ELAVON_PUBLIC_KEY=
ELAVON_SECRET_KEY=
ELAVON_PAYMENTS_API_BASE_URL=https://api.elavonpayments.com
ELAVON_PAYMENTS_SERVER_SECRET=
