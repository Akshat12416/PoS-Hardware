# Software-only demo (no devices). Never enable on a live register.
# DEMO_MODE=true
# HARDWARE_PORT=3011

# --- Agent ---
CLOUD_URL=https://pos-7mvx.onrender.com
# NGROK_URL is only needed for the cloud proxy path, not local device tests.
# NGROK_URL=https://YOUR-TUNNEL.ngrok-free.dev

# --- Printer ---
PRINTER_NAME=EPSON TM-T88V Receipt

# --- Scale (leave empty until Device Manager COM port is confirmed) ---
SCALE_SERIAL_PATH=
SCALE_BAUD_RATE=9600

# --- Scanner: auto | serial | usb_hid | keyboard_wedge | disabled ---
SCANNER_MODE=auto
SCANNER_SERIAL_PATH=
SCANNER_BAUD_RATE=9600
# Zebra DS2278 typical VID is 0x05E0. Set both to avoid grabbing the Cherry keyboard.
SCANNER_HID_VENDOR_ID=
SCANNER_HID_PRODUCT_ID=
SCANNER_ALLOW_KEYBOARD_WEDGE=false

# --- Cash drawer: unconfigured | serial | printer ---
CASH_DRAWER_MODE=unconfigured
CASH_DRAWER_SERIAL_PATH=
CASH_DRAWER_BAUD_RATE=9600

# --- Ingenico / CWS bridge (legacy env names pax_*) ---
PAX_ENABLED=true
PAX_BRIDGE_URL=http://127.0.0.1:7001
PAX_BRIDGE_PORT=7001
PAX_TIMEOUT_MS=120000
PAX_STRICT_STARTUP=false
PAX_BRIDGE_STARTUP_PROBE=true
PAYMENT_TERMINAL_TYPE=ingenico
PAYMENT_TERMINAL_MODEL=LAN360-USPOS16A
PAYMENT_TERMINAL_SERIAL=
PAYMENT_TERMINAL_CONNECTION=usb
CWS_BASE_URL=https://localhost:9790/rest/command
CWS_AUTO_CONFIGURE_READER=false

# Converge credentials — set from Elavon, never commit
CONVERGE_SSL_MERCHANT_ID=
CONVERGE_SSL_USER_ID=
CONVERGE_SSL_PIN=
CONVERGE_SSL_VENDOR_ID=

# Optional processor connection overlay (no defaults in source)
PAX_ELAVON_MID=
PAX_ELAVON_TID=
PAX_ELAVON_BANK_TERMINAL_ID=
PAX_ELAVON_DBA=SOUTHWEST FARMERS MARKET
